# Vantageo environment configuration.
# Copy this file to `.env` for local dev or set the values in your
# hosting platform's dashboard (Render: Environment → Add Env Var).

# ---------- Data backend ----------
# auto     — try FalkorDB, fall back to json_formate/*.json (default)
# falkordb — require FalkorDB; raise on startup if unreachable
# json     — skip the network call, use the bundled JSON files
VANTAGEO_DATA_BACKEND=auto

# FalkorDB connection (only used when VANTAGEO_DATA_BACKEND is auto or falkordb)
FALKORDB_HOST=localhost
FALKORDB_PORT=6380

# ---------- LLM provider ----------
# nvidia      — NVIDIA NIM (default endpoint: https://integrate.api.nvidia.com)
# commandcode — OpenAI-compatible endpoint (default: https://api.commandcode.ai)
VANTAGEO_LLM_PROVIDER=commandcode
VANTAGEO_LLM_MODEL=deepseek/deepseek-v4-flash

# API keys — pick the one that matches VANTAGEO_LLM_PROVIDER.
# nvidia      → NVIDIA_API_KEY
# commandcode → CC_LLM_API_KEY (also accepts CMD_API_KEY or OPENAI_API_KEY)
# Do NOT commit real keys. On Render, set these as "Secret" env vars.
NVIDIA_API_KEY=
CC_LLM_API_KEY=
CMD_API_KEY=
OPENAI_API_KEY=

# Optional: override the LLM endpoint URL (for self-hosted or proxies).
# Default for commandcode: https://api.commandcode.ai/provider/v1/chat/completions
# CC_LLM_ENDPOINT=https://api.commandcode.ai/provider/v1/chat/completions

# ---------- HTTP server ----------
# Render sets PORT automatically; only override for local runs.
# PORT=8000

# ---------- CORS ----------
# Comma-separated list of allowed origins, or * for any.
# On Render the frontend and backend share an origin, so * is safe.
CORS_ORIGINS=*

# ---------- Optional: config file location ----------
# Defaults to <repo>/config.json; falls back to <parent-of-repo>/config.json
# for legacy local dev. Override if you keep config elsewhere.
# VANTAGEO_CONFIG_PATH=/etc/vantageo/config.json

# ---------- Optional: structured JSON logs ----------
# Set to 1 to emit JSON log lines (handy for log aggregators).
VANTAGEO_LOG_JSON=0

# ---------- Optional: dev-only hot reload ----------
# Set to 1 to run uvicorn with --reload (do NOT use in production).
# VANTAGEO_RELOAD=1
